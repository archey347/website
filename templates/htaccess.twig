# Generated by the build - do not edit this by hand.
# Redirects live in redirects.json, error pages in jobs/errors.yaml.
#
# The DirectorySlash and Options lines below need AllowOverride Indexes and
# Options (AllowOverride All covers both). Without them apache answers every
# request with a 500, so that is the first thing to check if the site dies
# after a deploy.

ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 402 /errors/402.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 405 /errors/405.html
ErrorDocument 406 /errors/406.html
ErrorDocument 500 /errors/500.html

# Pages are built as <name>/index.html but are served as /about, with no
# trailing slash. mod_dir would otherwise bounce /about off to /about/
# before mod_rewrite gets a look in, so stop it doing that. Directory
# listings stay off; nothing here serves a directory directly.
DirectorySlash Off
Options -Indexes

RewriteEngine On

# /about/ is not canonical, so send it to /about.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /about is served from /about/index.html.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]
{% if redirects is not empty %}

# Old urls, kept working so that nothing already out there breaks.
{% for redirect in redirects %}
RedirectMatch {{ redirect.status }} {{ redirect.pattern }} {{ redirect.to }}
{% endfor %}
{% endif %}
