# Generated by the build - do not edit this by hand.
# Redirects live in redirects.json, error pages in jobs/errors.yaml.

DirectoryIndex index.html

ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 402 /errors/402.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 405 /errors/405.html
ErrorDocument 406 /errors/406.html
ErrorDocument 500 /errors/500.html
{% if redirects is not empty %}

# Old urls, kept working so that nothing already out there breaks.
{% for redirect in redirects %}
RedirectMatch {{ redirect.status }} {{ redirect.pattern }} {{ redirect.to }}
{% endfor %}
{% endif %}
