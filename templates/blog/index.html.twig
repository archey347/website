{% extends 'abstract.html.twig' %}

{% block title %}Blog - Archey Barrell{% endblock %}

{% block page_content %}
<h2>Blog</h2>

<p><a href="/feed.xml">RSS Feed</a></p>

{% if blogs is empty %}
<p>No blog posts found.</p>
{% else %}
<dl>
{% for blog in blogs %}
  <dt><a href="{{ blog.url }}">{{ blog.title }}</a></dt>
  <dd>
    {{ blog.published_at | date('j F Y') }}
    {%- if blog.tags is not empty %} &middot; {{ blog.tags | join(', ') }}{% endif %}
  </dd>
{% endfor %}
</dl>
{% endif %}
{% endblock %}
