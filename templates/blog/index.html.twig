{% extends 'abstract.html.twig' %}

{% block title %}Blog - Archey Barrell{% endblock %}

{% block page_content %}
<h2>Blog</h2>

<p><a href="/feed.xml">RSS Feed</a></p>

<hr>

<ul>
{% for blog in blogs %}
  <li>
    {{ blog.published_at | date('j F Y') }} &mdash;
    <a href="{{ blog.url }}">{{ blog.title }}</a>
  </li>
{% else %}
  <li>No blog posts found.</li>
{% endfor %}
</ul>
{% endblock %}
