{% extends 'abstract.html.twig' %}

{% block title %}{{ blog.title }} - Archey Barrell{% endblock %}

{% block page_content %}
<h2>{{ blog.title }}</h2>

<p>
  <small>Published {{ blog.published_at | date('j F Y') }} | Tags: {{ blog.tags | join(', ') }}</small>
</p>

{{ blog.content | raw }}

<p><a href="/blog">&lt;&lt; Back to the blog</a></p>
{% endblock %}
